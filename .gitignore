# Ignore everything at the root level by default
/*

# Allow .gitignore itself to be tracked
!.gitignore

# Allow the specific required files and directories
!src/
!requirements.txt
!schemas.py
!main.py

# Ignore Python cache/compiled files inside allowed directories
**/__pycache__/
**/*.py[cod]
**/*$py.class

# Ignore specific development/testing files inside allowed directories
**/*.ipynb
**/*.db
**/*.sqlite3

# Specific Files
src/database/database_create_production.py
platform_frontend/

frontend/
frontend_2/